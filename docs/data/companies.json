    "what_a_score_is": "A 0-5 judgement of how visibly an organisation is investing in a need, read off public evidence: shipped products, published research, named teams, acquisitions, and stated priorities. It is a measure of visible commitment, not of spend, headcount, or competence.",
    "how_scored": [
      "5 — a core strategic bet: a named product line or research programme the organisation leads with.",
      "4 — a dedicated team or shipped product, but not the thing they are known for.",
      "3 — a named priority in public material, without a dedicated product behind it.",
      "2 — some visible investment: a blog series, a feature, a conference talk.",
      "1 — mentioned in passing.",
      "0 — no public signal found. NOT evidence of absence."
    ],
    "biases_to_hold_in_mind": [
      {
        "bias": "Publication bias",
        "effect": "Organisations that market loudly score higher than quiet ones doing more. A bank with a serious internal AI-security function and no blog scores below a startup with a landing page."
      },
      {
        "bias": "Vendor-product conflation",
        "effect": "For security vendors, a high score may reflect what they sell rather than what they have solved. Selling an agent-security product is evidence of market demand, not of the problem being addressed."
      },
      {
        "bias": "Recency",
        "effect": "Scores track what has been published lately. A team that did foundational work three years ago and moved on will read as less committed than one that shipped a blog post last month."
      },
