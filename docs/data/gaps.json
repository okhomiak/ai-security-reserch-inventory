    {
      "id": "gap-unlearning-evaluation",
      "title": "Unlearning evaluation cannot distinguish removal from concealment",
      "severity": "high",
      "status": "open",
      "categories": [
        "defense.unlearning",
        "eval.dangercap",
        "interp.probes"
      ],
      "needs": [
        "n.privacy",
        "n.evals",
        "n.compliance"
      ],
      "papers": [
        "arxiv:2310.02238",
        "arxiv:2403.03218",
        "arxiv:2406.11717"
      ],
      "chain": [
        {
          "step": 1,
          "claim": "Approximate unlearning became the practical answer to deletion requests and to hazardous-knowledge removal, because retraining is infeasible.",
          "evidence": [
            {
              "type": "paper",
              "id": "arxiv:2310.02238"
            },
            {
              "type": "paper",
              "id": "arxiv:2403.03218"
            }
          ]
        },
        {
          "step": 2,
          "claim": "Both are evaluated by querying the model and observing that it no longer answers - a behavioural test."
        },
        {
          "step": 3,
          "claim": "But behaviour and capability come apart: refusal is mediated by a single removable direction, so a model can hold a capability it does not display.",
          "evidence": [
            {
              "type": "paper",
              "id": "arxiv:2406.11717"
            }
          ]
        },
        {
          "step": 4,
          "claim": "And a deliberately implanted behaviour survives the full safety-training stack, which the same behavioural tests would score as clean.",
          "evidence": [
            {
              "type": "paper",
              "id": "arxiv:2401.05566"
            }
          ]
        },
        {
          "step": 5,
          "claim": "Gap: no evaluation establishes that unlearned information is gone rather than suppressed - which is precisely the claim a deletion obligation or a capability threshold requires."
        }
      ],
      "refreshed": "2026-11-04"
    },
